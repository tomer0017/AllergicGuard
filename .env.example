# AllergicGuard configuration.
# Everything here is PUBLIC — it is bundled into the browser build.
# Never put an API secret in this file. Secret-bearing providers must be
# proxied by a backend service (see README).

# --- Providers -------------------------------------------------------------
VITE_ENABLE_OPEN_FOOD_FACTS=true
VITE_OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# Disabled: no official public API documentation/credentials yet.
VITE_ENABLE_GS1=false
VITE_GS1_BASE_URL=

# Disabled: identity-only source, requires per-chain credentials.
VITE_ENABLE_ISRAEL_RETAIL=false
VITE_ISRAEL_RETAIL_BASE_URL=

# --- HTTP ------------------------------------------------------------------
VITE_HTTP_TIMEOUT_MS=8000
VITE_HTTP_RETRY_ATTEMPTS=1
VITE_USER_AGENT=AllergicGuard/0.1 (peanut-allergy-check)

# --- Cache (performance only, never a safety source) -----------------------
VITE_ENABLE_CACHE=true
VITE_CACHE_TTL_MS=600000

# --- Development -----------------------------------------------------------
VITE_LOG_LEVEL=debug
VITE_ENABLE_DEBUG_PANEL=true
VITE_SCAN_COOLDOWN_MS=3000
