# AllergicGuard configuration.
# Everything here is PUBLIC — it is bundled into the browser build.
# Never put an API secret in this file. Secret-bearing providers must be
# proxied by a backend service (see README).

# --- Providers -------------------------------------------------------------
VITE_ENABLE_OPEN_FOOD_FACTS=true
VITE_OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# Disabled: no official public API documentation/credentials yet.
VITE_ENABLE_GS1=false
VITE_GS1_BASE_URL=

# Disabled: identity-only source, requires per-chain credentials.
VITE_ENABLE_ISRAEL_RETAIL=false
VITE_ISRAEL_RETAIL_BASE_URL=

# Disabled: barcode lookup is Premier-only and allergen access is granted
# separately. OAuth secrets cannot ship in a static build, so this points at a
# PROXY that holds them — never at FatSecret, and never at a key.
VITE_ENABLE_FATSECRET=false
VITE_FATSECRET_PROXY_URL=

# --- Package photo analysis (browser-side OCR) -----------------------------
# Runs entirely on the device via Tesseract.js WASM. No API key exists here
# because none may: a static build cannot hold a secret. A hosted Vision
# provider would need a serverless proxy and a proxy URL, never a credential.
VITE_ENABLE_PACKAGE_SCAN=true
VITE_PACKAGE_SCAN_LANGUAGES=heb+eng
# Optional self-hosted mirrors. Empty = the library's jsDelivr default.
VITE_PACKAGE_SCAN_CORE_PATH=
VITE_PACKAGE_SCAN_LANG_PATH=

# Optional second opinion, used ONLY when local OCR could not read the label.
# Points at a proxy that holds the model API key. A Vision key must never
# appear in any VITE_* variable: everything here ships to the browser.
VITE_ENABLE_REMOTE_VISION=false
VITE_REMOTE_VISION_PROXY_URL=
VITE_REMOTE_VISION_TIMEOUT_MS=20000

# --- HTTP ------------------------------------------------------------------
VITE_HTTP_TIMEOUT_MS=8000
VITE_HTTP_RETRY_ATTEMPTS=1
VITE_USER_AGENT=AllergicGuard/0.1 (peanut-allergy-check)

# --- Cache (performance only, never a safety source) -----------------------
VITE_ENABLE_CACHE=true
VITE_CACHE_TTL_MS=600000

# --- Development -----------------------------------------------------------
VITE_LOG_LEVEL=debug
VITE_ENABLE_DEBUG_PANEL=true
VITE_SCAN_COOLDOWN_MS=3000
